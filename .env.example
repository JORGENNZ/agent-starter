# ─── Anthropic (Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Meta WhatsApp Cloud API ────────────────────────────────
# Token de la app y phone_number_id de Meta for Developers
META_ACCESS_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345

# ─── OpenAI (Whisper + TTS) ─ opcional ──────────────────────
# Sin estas keys el agente solo procesa texto/imagen/PDF.
# Con ellas, también acepta notas de voz y puede responder con audio.
OPENAI_API_KEY=sk-...
TTS_VOICE=onyx                 # onyx | echo | alloy | nova | shimmer | fable
TTS_MODEL=tts-1                # tts-1 (rápido) | tts-1-hd (mejor calidad)

# ─── Servidor ───────────────────────────────────────────────
PORT=3000
DB_PATH=./agent.db

# ─── Admin (inspector de conversaciones) ────────────────────
ADMIN_USER=admin
ADMIN_PASS=cambia-esto
